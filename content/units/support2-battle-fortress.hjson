                }
            ]
        }
    ],

            "shoot": {
                "type": "ShootPattern",
                "shots": 3,
                "shotDelay": 7.5,
            },
    
            "bullet": { 
                "type": "BasicBulletType",
                "speed": 25, 
                "shootY": 45,
                "width": 15,
                "height": 25,
                "hitSize": 5,
                "healPercent": 15,
                "damage": 100,
                "pierceCap": 4,
                "pierceBuilding": true,
                "pierceDamageFactor": 0.80,
                "lifetime": 15,
                "collides": true,
                "collidesTiles": true,
                "trailColor": "#62AE7F",
                "trailLength": 10,
                "trailWidth": 5
                "backColor": "#62AE7F",
                "frontColor": "#62AE7F",
                "despawnShake": 0.625,
