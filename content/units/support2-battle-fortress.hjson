            "y": 10,
            "reload": 30,
            "recoil": 0,
            "targetInterval": 10,
            "targetSwitchInterval": 15,

            "bullet": {
                "type": "BulletType",
                "shootEffect": "sparkShoot",
                "hitEffect": "pointHit",
                "maxRange": 240,
                "damage": 60
            }
        },

        {   
            "type": "PointDefenseWeapon",
            "name": "support2-battle-fortress-point-defense-weapon",
            "mirror": false,
            "x": 11.5,
            "y": 10,
            "reload": 30,
            "recoil": 0,
            "targetInterval": 10,
            "targetSwitchInterval": 15,

            "bullet": {
                "type": "BulletType",
                "shootEffect": "sparkShoot",
                "hitEffect": "pointHit",
                "maxRange": 240,
                "damage": 60
            }
        },

        {
            "name": "support2-battle-fortress-turret",
            "reload": 75, 
            "x": 0, 
            "y": -5, 
            "top": true, 
            "rotate": true,
            "shootY": 10,
            "shake": 1.25,
            "shootSound": "tankShoot3",
            "ejectEffect": "casing4",
            "mirror": false,
            "rotateSpeed": 2.5,
            "recoil": 7.5,
            "parts": [
            {
            "type": "RegionPart",
            "suffix": "-coil",
            "x": 0, 
            "y": -0.34,
            "under": true,
            "moves": [
                {
                "type": "PartMove",
                "progress": "recoil",
