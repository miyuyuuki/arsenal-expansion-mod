{
    "type": "tank",
    "name": "[#84F491]Battle Fortress[]",
    "description": '''
    [#84F491]<Tier II Support Tank>[]

    Heavy support tank, fires bursts of high-damage supersonic bolts that pierce through enemy targets and repair allied structures. 
    
    Nullifies incoming bullets with point-defense weapons, projects a forcefield around itself, and accelerates allies' rate of fire around itself with its status field.

    Immune to Burning, Melting, Sapped, and Spore Slowed.
    ''',
    "details": "Not to be confused with vanilla Fortress.",
    "speed": 0.5,
    "template": "TankUnitType",
    "health": 6500,
    "armor": 25, 
    "treadPullOffset": 6,    
    "rotateSpeed": 2,
    "hitSize": 35, 
    "targetAir": false,
    "targetGround": true,
    "itemCapacity": 0,
    "crushDamage": 5,
    "immunities": ["burning", "melting", "sapped", "spore-slowed"],

    "treadRects": [
        {
            "name": "support2-battle-fortress-treads",
            "x": -56,
            "y": -74,
            "width": 20,
            "height": 208
        }
    ],

    "weapons": [ 
        {   
            "type": "PointDefenseWeapon",
            "name": "support2-battle-fortress-point-defense-weapon",
            "mirror": false,
